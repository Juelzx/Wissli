rules_version = '2';

// Sicherheitsregeln für Wissli — siehe CLAUDE.md ("Firebase & Firestore").
//
// Gruppen-Modell: keine feste Family-Hierarchie (Parent -> Child) mehr. Jede:r User kann beliebig
// viele Gruppen erstellen ("Familie Scholler", ein Freundeskreis, o. Ä.) und Mitglied mehrerer
// Gruppen sein. Mitgliedschaft + Rolle (OWNER/MEMBER) liegen pro Gruppe in der Subcollection
// groups/{groupId}/members/{uid} statt denormalisiert auf dem User-Dokument — ein User hat keine
// globale Rolle mehr. Owner = wer die Gruppe erstellt hat; einzige Rolle, die Mitglieder
// einladen/entfernen oder die Gruppe verwalten/löschen darf.
//
// Feldnamen für "users" sind 1:1 aus FirebaseAuthRepository.toFirestoreMap()/toUserOrNull()
// übernommen (die einzige Collection, die aktuell tatsächlich beschrieben wird). Für
// groups/members/questions/categories/challenges/favorites — noch keine Repositories
// implementiert — sind die Feldnamen aus CLAUDE.md "Domain-Modelle (Kern)" abgeleitet; bei der
// jeweiligen Erstimplementierung gegen die Regeln hier prüfen und bei Bedarf anpassen.
//
// Admin-Rechte für Questions/Categories (Content-Verwaltung über die künftige Admin-Web-App) sind
// noch nicht modelliert (kein globales Rollenkonzept mehr) — Client-Writes deshalb vorerst
// komplett gesperrt; Content-Pflege läuft bis dahin über die Firebase-Konsole/Admin-SDK, die an
// diese Regeln nicht gebunden sind.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'OWNER';
    }

    // users/{uid}: jede:r liest/schreibt ausschließlich das eigene Dokument. Keine Rolle mehr zu
    // validieren (siehe oben) — nur displayName/createdAt, keine weiteren personenbezogenen Daten.
    // Ältere Dokumente aus dem Family-Modell können noch role/familyId enthalten; die bleiben
    // lesbar, aber neu schreiben lassen sie sich nicht.
    match /users/{uid} {
      function isOwnDoc() {
        return isSignedIn() && request.auth.uid == uid;
      }

      function hasValidDisplayName() {
        return request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 50;
      }

      allow read: if isOwnDoc();

      allow create: if isOwnDoc()
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && hasValidDisplayName()
        && request.resource.data.createdAt is int;

      // Nur den displayName ändern; createdAt bleibt fix.
      allow update: if isOwnDoc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && hasValidDisplayName();

      allow delete: if false;

      // users/{uid}/progress/{categoryId}: Solo-Fortschritt, ein Dokument pro Thema (siehe
      // ProgressRepository). Levels werden der Reihe nach gespielt, deshalb reichen die Zahl
      // geschaffter Level plus die gelösten Fragen des aktuellen Levels. Pro Schreibvorgang darf
      // höchstens ein Level dazukommen und nie eins verloren gehen. Fälschungssicher ist das nicht
      // (der Client prüft die Antworten) — sobald Ränge im Gruppenmodus verglichen werden, muss
      // eine Cloud Function den Fortschritt schreiben.
      match /progress/{categoryId} {
        function isValidProgress() {
          let data = request.resource.data;
          return data.keys().hasOnly(['completedLevels', 'solvedInCurrentLevel', 'updatedAt'])
            && data.completedLevels is int
            && data.completedLevels >= 0
            && data.solvedInCurrentLevel is list
            && data.solvedInCurrentLevel.size() <= 20
            && data.updatedAt is int;
        }

        allow read: if isOwnDoc();

        allow create: if isOwnDoc()
          && isValidProgress()
          && request.resource.data.completedLevels <= 1;

        allow update: if isOwnDoc()
          && isValidProgress()
          && request.resource.data.completedLevels >= resource.data.completedLevels
          && request.resource.data.completedLevels <= resource.data.completedLevels + 1;

        allow delete: if false;
      }
    }

    // groups/{groupId}: lesbar für Mitglieder; erstellen kann jede:r (wird automatisch Owner,
    // siehe members-Subcollection unten); verwalten/löschen nur der Owner.
    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isGroupOwner(groupId);

      // groups/{groupId}/members/{memberUid}: Mitgliedschaft + Rolle einer Person in dieser Gruppe.
      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);

        // Zwei erlaubte Fälle beim Anlegen: (a) der Owner lädt eine weitere Person als MEMBER ein,
        // (b) die Gruppen-Ersteller:in trägt sich direkt nach dem Anlegen der Gruppe selbst als
        // OWNER ein (verifiziert über groups/{groupId}.createdBy statt einer eigenen "ist das der
        // allererste Member"-Prüfung).
        allow create: if isSignedIn()
          && ((isGroupOwner(groupId) && request.resource.data.role == 'MEMBER')
            || (request.auth.uid == memberUid
              && request.resource.data.role == 'OWNER'
              // getAfter statt get, damit Gruppe und erste Mitgliedschaft in einem Batch
              // geschrieben werden können (get sähe die Gruppe im selben Batch noch nicht).
              && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid));

        // Rollenwechsel nachträglich (z. B. Ownership übertragen) ist noch nicht vorgesehen.
        allow update: if false;

        // Der Owner entfernt Mitglieder, oder ein Mitglied verlässt die Gruppe selbst. Der Owner
        // kann sich damit theoretisch selbst entfernen, ohne die Ownership zu übertragen — dieser
        // Edge-Case ist bewusst ungelöst, bis das echte Group-Repository existiert.
        allow delete: if isGroupOwner(groupId) || request.auth.uid == memberUid;
      }
    }

    // questions/{questionId}, categories/{categoryId}: global, gruppenunabhängig. Öffentlich
    // lesbar nur wenn published; Schreiben vorerst komplett gesperrt (siehe Admin-Hinweis oben).
    match /questions/{questionId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // challenges/{challengeId}: verbindet zwei Mitglieder derselben Gruppe (createdBy/assignedTo
    // beliebige Mitglieder, keine Parent/Child-Einschränkung mehr). Lesen/Schreiben nur innerhalb
    // der eigenen Gruppenmitgliedschaft.
    match /challenges/{challengeId} {
      allow read: if isGroupMember(resource.data.groupId);

      allow create: if isGroupMember(request.resource.data.groupId)
        && request.resource.data.createdBy == request.auth.uid
        && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.resource.data.assignedTo));

      allow update: if isGroupMember(resource.data.groupId)
        && (request.auth.uid == resource.data.assignedTo || request.auth.uid == resource.data.createdBy);

      allow delete: if isGroupMember(resource.data.groupId) && request.auth.uid == resource.data.createdBy;
    }

    // favorites/{favoriteId}: gehört ausschließlich der/dem besitzenden Nutzer:in, verändert nie
    // die referenzierte Question (siehe CLAUDE.md "Domain-Modelle").
    match /favorites/{favoriteId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Alles außerhalb der obigen Collections ist implizit gesperrt (kein catch-all match).
  }
}
