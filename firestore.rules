rules_version = '2';

// Security rules for Wissli, see CLAUDE.md ("Firebase & Firestore" and "Gruppen & Gruppenmodus").
//
// Timestamps: users/progress keep epoch millis (int) because the existing Kotlin code writes them that
// way. Everything in the group model uses Firestore timestamps written as serverTimestamp(), so the
// rules can pin them to request.time and enforce invite expiry and per-question timers server-side.
//
// Written by Cloud Functions only (Admin SDK, not bound by these rules): rounds, their questions and
// solutions, and the group-mode question pool. Clients can never read a correct answer before they
// have finished a round, because the pool and the solutions never reach a client earlier.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function memberPath(groupId, uid) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(uid);
    }

    function isGroupMember(groupId) {
      return isSignedIn() && exists(memberPath(groupId, request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return isGroupMember(groupId)
        && get(memberPath(groupId, request.auth.uid)).data.role == 'OWNER';
    }

    function isValidDisplayName(name) {
      return name is string && name.size() <= 50;
    }

    // users/{uid}: only the own document, and nothing beyond displayName/createdAt. Older documents
    // from the family model may still contain role/familyId; they stay readable but cannot be
    // written again.
    match /users/{uid} {
      function isOwnDoc() {
        return isSignedIn() && request.auth.uid == uid;
      }

      allow read: if isOwnDoc();

      allow create: if isOwnDoc()
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && isValidDisplayName(request.resource.data.displayName)
        && request.resource.data.createdAt is int;

      allow update: if isOwnDoc()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && isValidDisplayName(request.resource.data.displayName);

      allow delete: if false;

      // users/{uid}/progress/{categoryId}: solo progress, one document per topic. Levels are played
      // in order, so completed levels plus the solved questions of the current level are enough. At
      // most one level may be added per write and none may be lost. This is not tamper-proof (the
      // client checks the answers); group mode therefore never compares solo progress.
      match /progress/{categoryId} {
        function isValidProgress() {
          let data = request.resource.data;
          return data.keys().hasOnly(['completedLevels', 'solvedInCurrentLevel', 'updatedAt'])
            && data.completedLevels is int
            && data.completedLevels >= 0
            && data.solvedInCurrentLevel is list
            && data.solvedInCurrentLevel.size() <= 20
            && data.updatedAt is int;
        }

        allow read: if isOwnDoc();

        allow create: if isOwnDoc()
          && isValidProgress()
          && request.resource.data.completedLevels <= 1;

        allow update: if isOwnDoc()
          && isValidProgress()
          && request.resource.data.completedLevels >= resource.data.completedLevels
          && request.resource.data.completedLevels <= resource.data.completedLevels + 1;

        allow delete: if false;
      }
    }

    // inviteCodes/{code}: the only way into a group. Knowing the code is the authorization, so a
    // single get is open to every signed-in user (to preview the group name before joining), but
    // listing is limited to the creator's own codes. Codes are 8 characters from an alphabet without
    // look-alikes (no 0/O/1/I), roughly 10^12 combinations, and expire after at most 7 days.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();

      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      allow create: if isGroupOwner(request.resource.data.groupId)
        && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.groupName is string
        && request.resource.data.groupName.size() <= 50
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');

      allow update: if false;

      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.uid || isGroupOwner(resource.data.groupId));
    }

    // Collection-group query "all groups of a user": members where userId == me.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // groups/{groupId}: readable for members. Anyone can create a group and must add themselves as
    // OWNER in the same batch. Renaming and deleting is owner-only.
    match /groups/{groupId} {
      function groupPath() {
        return /databases/$(database)/documents/groups/$(groupId);
      }

      allow read: if isGroupMember(groupId);

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && existsAfter(memberPath(groupId, request.auth.uid));

      allow update: if isGroupOwner(groupId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50;

      // Subcollections are not deleted with the group. The client deletes all member documents and
      // the group in one batch (see members.delete); orphaned rounds are unreadable afterwards
      // because nobody is a member any more, and a Cloud Function can clean them up later.
      allow delete: if isGroupOwner(groupId);

      // groups/{groupId}/members/{memberUid}: membership, role and displayName. The name is copied
      // here because users/{uid} is private, and members need to see each other's names.
      match /members/{memberUid} {
        function isValidMember(role) {
          let data = request.resource.data;
          return data.userId == memberUid
            && data.role == role
            && isValidDisplayName(data.displayName)
            && data.joinedAt == request.time;
        }

        // The invite must belong to this group and still be valid at the moment of joining.
        function hasValidInvite() {
          let invitePath = /databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode);
          return request.resource.data.inviteCode is string
            && exists(invitePath)
            && get(invitePath).data.groupId == groupId
            && get(invitePath).data.expiresAt > request.time;
        }

        allow read: if isGroupMember(groupId);

        // Only the person themselves creates their membership: (a) the creator as OWNER in the batch
        // that creates the group (exists() still sees the state before the batch), or (b) anyone else
        // as MEMBER with a valid invite code. Owners cannot add people directly.
        allow create: if isSignedIn()
          && request.auth.uid == memberUid
          && ((request.resource.data.keys().hasOnly(['userId', 'role', 'displayName', 'joinedAt'])
              && isValidMember('OWNER')
              && !exists(groupPath())
              && getAfter(groupPath()).data.createdBy == request.auth.uid)
            || (request.resource.data.keys().hasOnly(['userId', 'role', 'displayName', 'joinedAt', 'inviteCode'])
              && isValidMember('MEMBER')
              && exists(groupPath())
              && hasValidInvite()));

        // Members keep their own copy of displayName in sync; roles never change (no ownership
        // transfer yet).
        allow update: if isSignedIn()
          && request.auth.uid == memberUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && isValidDisplayName(request.resource.data.displayName);

        // The owner removes other members, a member leaves on their own. The owner can only remove
        // themselves while deleting the whole group in the same batch, so no group is left without
        // an owner.
        allow delete: if isSignedIn()
          && ((isGroupOwner(groupId) && request.auth.uid != memberUid)
            || (request.auth.uid == memberUid && resource.data.role == 'MEMBER')
            || (request.auth.uid == memberUid && isGroupOwner(groupId) && !existsAfter(groupPath())));
      }

      // groups/{groupId}/rounds/{roundId}: one round of group mode, created by the startRound Cloud
      // Function (picks questions from groupQuestions, writes questions and solution separately).
      // Everyone plays at their own pace until endsAt; each question has its own timer.
      match /rounds/{roundId} {
        function round() {
          return get(/databases/$(database)/documents/groups/$(groupId)/rounds/$(roundId)).data;
        }

        function participantPath(uid) {
          return /databases/$(database)/documents/groups/$(groupId)/rounds/$(roundId)/participants/$(uid);
        }

        function hasStarted() {
          return exists(participantPath(request.auth.uid));
        }

        function hasFinished() {
          return hasStarted()
            && get(participantPath(request.auth.uid)).data.answers.size() == round().questionCount;
        }

        // Answers and solution are visible to whoever has finished the round, and to every member
        // once the round is over, so nobody can look up the answers before playing.
        function canSeeResults() {
          return request.time > round().endsAt || hasFinished();
        }

        allow read: if isGroupMember(groupId);
        allow write: if false;

        // content/questions: texts and answer options, without the correct index. Readable only
        // after starting, which starts the timer for the first question.
        match /content/questions {
          allow read: if isGroupMember(groupId) && hasStarted();
          allow write: if false;
        }

        // content/solution: correct indices and explanations.
        match /content/solution {
          allow read: if isGroupMember(groupId) && canSeeResults();
          allow write: if false;
        }

        // participants/{uid}: one document per player. answers is a map "0", "1", ... -> {choice, at}
        // (a map rather than a list, because serverTimestamp() is not allowed inside arrays).
        // choice -1 means the timer ran out. Answers are append-only, strictly in order, and a real
        // answer must arrive within secondsPerQuestion (plus a little network grace) after the
        // previous answer, or after startedAt for the first question.
        match /participants/{uid} {
          function isValidAnswerAppend() {
            let r = round();
            let before = resource.data.answers;
            let after = request.resource.data.answers;
            let n = before.size();
            let key = string(n);
            let previousAt = n == 0 ? resource.data.startedAt : before[string(n - 1)].at;
            let answer = after[key];
            return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers'])
              && after is map
              && n < r.questionCount
              && after.diff(before).addedKeys() == [key].toSet()
              && after.diff(before).affectedKeys() == [key].toSet()
              && answer.keys().hasOnly(['choice', 'at'])
              && answer.at == request.time
              && answer.choice is int
              && (answer.choice == -1
                || (answer.choice >= 0
                  && answer.choice < r.answerCounts[n]
                  && request.time <= previousAt + duration.value(r.secondsPerQuestion + 3, 's')));
          }

          allow read: if isGroupMember(groupId) && (request.auth.uid == uid || canSeeResults());

          allow create: if isGroupMember(groupId)
            && request.auth.uid == uid
            && request.time < round().endsAt
            && request.resource.data.keys().hasOnly(['displayName', 'startedAt', 'answers'])
            && isValidDisplayName(request.resource.data.displayName)
            && request.resource.data.startedAt == request.time
            && request.resource.data.answers == {};

          allow update: if isGroupMember(groupId)
            && request.auth.uid == uid
            && isValidAnswerAppend();

          allow delete: if false;
        }
      }
    }

    // groupQuestions/{questionId}: the separate group-mode pool, including correct answers. Only
    // Cloud Functions read it; it never reaches the app bundle or a client.
    match /groupQuestions/{questionId} {
      allow read, write: if false;
    }

    // questions/{questionId}, categories/{categoryId}: global solo content for a future admin web
    // app (the app itself plays from the bundled package). Publicly readable only when published;
    // client writes are blocked until admin rights are modelled.
    match /questions/{questionId} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // favorites/{favoriteId}: owned by one user, never changes the referenced question.
    match /favorites/{favoriteId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Everything else (including challenges from the old 1:1 concept) is denied implicitly.
  }
}
