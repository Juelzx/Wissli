<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- The last signed-in account (name + email) stays on this device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="last_signed_in_account.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="last_signed_in_account.xml" />
    </device-transfer>
</data-extraction-rules>
